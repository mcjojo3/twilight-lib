# ---------- .gitignore ----------

# OS
.DS_Store
Thumbs.db

# IDEs (IntelliJ, Eclipse, VS Code)
/.idea/
/*.iml
/*.ipr
/*.iws
/.vscode/

# Build outputs (any depth - each module has its own build/run dirs)
**/build/
**/out/
/bin/
**/bin/
/target/
**/run/
**/run-data/

# Module-specific build outputs (standalone projects)
/forge-1.20.1/build/
/forge-1.20.1/out/
/forge-1.20.1/run/
/forge-1.20.1/run-data/
/forge-1.20.1/.gradle/
/forge-1.20.1/.gradle-forge/

/neoforge-1.21.1/build/
/neoforge-1.21.1/out/
/neoforge-1.21.1/runs/
/neoforge-1.21.1/run-data/
/neoforge-1.21.1/.gradle/
/neoforge-1.21.1/.gradle-neoforge/

# Common assets folder (shared resources)
# DO NOT ignore - this contains shared assets between modules
# /common/

# Gradle caches and local config (any depth - each module gets its own .gradle/)
**/.gradle/
gradle-local.properties

# Leftover Gradle internal cache state committed by accident (not the usual
# hidden .gradle/ path - safe to ignore/untrack, Gradle regenerates it)
/1.21.1/neoforge/8.8/

# Project metadata (Eclipse)
/.classpath
/.project
/.settings/

# Logs and temporary files
*.log
hs_err_pid*
*.tmp
*.swp

# Minecraft / Forge MDK local caches and run folders
*.lock
*.cache
run/
run-data/
build/
out/

# Miscellaneous
.idea_modules/
coverage/
tmp/
.cache/
*.bak
*.bak2
*.orig
.env

# IDE workspace folders
.claude/

# Windows shortcuts & legacy
*.lnk
NUL
/.legacy

# Assistants & Local Tools
.gemini/
.history/

# Additional Minecraft Junk
crash-reports/
usercache.json
usernamecache.json
stats/
advancements/
backups/
screenshots/
logs/
!/src/**/logs/  # Keep logs directory in source if it exists
replay_mod_recordings/
.mixin.out/
.mixin.out

# Additional IDE & System
.factorypath
*.code-workspace
*.launch
.nb-gradle
.vscode-test/
desktop.ini
$RECYCLE.BIN/
System Volume Information/
*.patch
*.diff

# Java & Local Config
local.properties
.apt_generated/
*.jar
!gradle-wrapper.jar

# Umbrella Ignores (Ignore all of a type except specific ones)
*.md
!README.md

*.txt
!LICENSE.txt
!CREDITS.txt
*.ps1
