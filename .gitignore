# ---------- .gitignore ----------

# OS
.DS_Store
Thumbs.db

# IDEs (IntelliJ, Eclipse, VS Code)
/.idea/
/*.iml
/*.ipr
/*.iws
/.vscode/

# Build outputs
/build/
/out/
/bin/
/target/
/run/
/run-data/

# Gradle caches and local config
/.gradle/
.gradle/
gradle-local.properties

# Project metadata (Eclipse)
/.classpath
/.project
/.settings/

# Logs and temporary files
*.log
hs_err_pid*
*.tmp
*.swp

# Minecraft / Forge MDK local caches and run folders
*.lock
*.cache
run/
run-data/
build/
out/

# Miscellaneous
.idea_modules/
coverage/
tmp/
.cache/
*.bak
*.orig
.env

# Exclude misc folders/files
.claude/
DEVELOPER_GUIDE.txt
ADDON_CONVERSION_TUTORIAL.txt
TRAIL_TUTORIAL.txt
zoe_quotes_reference.txt
assets.Ink