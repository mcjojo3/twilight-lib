# ---------- .gitignore ----------

# OS
.DS_Store
Thumbs.db

# IDEs (IntelliJ, Eclipse, VS Code)
/.idea/
/*.iml
/*.ipr
/*.iws
/.vscode/

# Build outputs
/build/
/out/
/bin/
/target/
/run/
/run-data/

# Module-specific build outputs (standalone projects)
/forge-1.20.1/build/
/forge-1.20.1/out/
/forge-1.20.1/run/
/forge-1.20.1/run-data/
/forge-1.20.1/.gradle/
/forge-1.20.1/.gradle-forge/

/neoforge-1.21.1/build/
/neoforge-1.21.1/out/
/neoforge-1.21.1/runs/
/neoforge-1.21.1/run-data/
/neoforge-1.21.1/.gradle/
/neoforge-1.21.1/.gradle-neoforge/

# Common assets folder (shared resources)
# DO NOT ignore - this contains shared assets between modules
# /common/

# Gradle caches and local config
/.gradle/
gradle-local.properties

# Project metadata (Eclipse)
/.classpath
/.project
/.settings/

# Logs and temporary files
*.log
hs_err_pid*
*.tmp
*.swp

# Minecraft / Forge MDK local caches and run folders
*.lock
*.cache
run/
run-data/
build/
out/

# Miscellaneous
.idea_modules/
coverage/
tmp/
.cache/
*.bak
*.bak2
*.orig
.env

# IDE workspace folders
.claude/

# Windows shortcuts (leftover from old structure)
*.lnk
NUL
TRAIL_TUTORIAL.txt
zoe_quotes_reference.txt
ADDON_CONVERSION_TUTORIAL.txt
DEVELOPER_GUIDE.txt
QUOTE_STANDARD.md
code_audit.md
ADDON_TUTORIAL.txt
CONFIG_AUDIT_REPORT.md
code_audit_2025-12-04.md
